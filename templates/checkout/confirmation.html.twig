{% extends 'base.html.twig' %}

{% block body %}
<div id="app" class="my-5">
    <div class="container">
        <div class="component-light purchase p-4 shadow-sm rounded">

            <!-- Duży nagłówek -->
            <div class="text-center mb-4">
                <h1 class="display-4 text-primary">Thank you for your purchase!</h1>
                <p class="lead text-secondary">Your order has been successfully submitted.</p>
            </div>

            <!-- Shipping Instructions -->
            <div class="mb-4 p-3 bg-light rounded">
                <h4 class="text-info mb-2">Shipping Instructions</h4>
                <p>
                    To complete the transaction, please print this page and mail it together
                    with a check or money order to the following address:
                </p>
                <code>
                    Furniture and staff shop<br>
                    Łódź City 90-900, LDZ<br>
                    POLAND
                </code>
                <p class="mt-2 text-muted">
                    Estimated delivery: <strong>12-24 weeks</strong>
                </p>
            </div>

            <!-- Customer Information -->
            <div class="mb-4 p-3 bg-light rounded">
                <h4 class="text-success mb-2">Customer Information</h4>
                <p><strong>Name:</strong> {{ purchase.customerName }}</p>
                <p><strong>Email:</strong> {{ purchase.customerEmail }}</p>
                <p><strong>Phone:</strong> {{ purchase.customerPhone }}</p>
                <p><strong>Address:</strong> {{ purchase.customerAddress }}, {{ purchase.customerZip }} {{ purchase.customerCity }}</p>
            </div>

            <!-- Order Details -->
            <div class="mb-4">
                <h4 class="text-warning mb-2">Order Details</h4>
                <table class="table table-bordered table-hover">
                    <thead class="table-secondary">
                        <tr>
                            <th style="width:10%;">Qty</th>
                            <th style="width:50%;">Product</th>
                            <th style="width:20%;">Color</th>
                            <th style="width:20%;" class="text-end">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in purchase.purchaseItems %}
                            <tr>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.product.name }}</td>
                                <td>{% if item.color is not null %}{{ item.color.name }}{% else %}-{% endif %}</td>
                                <td class="text-end">${{ (item.product.price / 100)|number_format(2) }}</td>
                            </tr>
                        {% endfor %}
                        <tr class="fw-bold table-success">
                            <td colspan="3" class="text-end">Total Price</td>
                            <td class="text-end">${{ (totalPrice / 100)|number_format(2) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Call to action -->
            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary btn-lg">Continue Shopping</a>
            </div>

        </div>
    </div>
</div>
{% endblock %}
